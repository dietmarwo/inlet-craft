{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "additionalProperties": false,
  "definitions": {
    "Diagnostic": {
      "additionalProperties": false,
      "properties": {
        "allowed": {
          "items": {
            "format": "double",
            "type": "number"
          },
          "maxItems": 2,
          "minItems": 2,
          "type": [
            "array",
            "null"
          ]
        },
        "code": {
          "type": "string"
        },
        "formula": {
          "type": [
            "string",
            "null"
          ]
        },
        "message": {
          "type": "string"
        },
        "path": {
          "type": "string"
        },
        "quantity": {
          "type": [
            "string",
            "null"
          ]
        },
        "value": {
          "format": "double",
          "type": [
            "number",
            "null"
          ]
        }
      },
      "required": [
        "code",
        "message",
        "path"
      ],
      "type": "object"
    },
    "Fixture": {
      "additionalProperties": false,
      "properties": {
        "absolute_tolerance": {
          "format": "double",
          "type": "number"
        },
        "evidence_kind": {
          "type": "string"
        },
        "expected": {
          "format": "double",
          "type": "number"
        },
        "formula": {
          "type": "string"
        },
        "id": {
          "type": "string"
        },
        "inputs": {
          "items": {
            "format": "double",
            "type": "number"
          },
          "type": "array"
        },
        "relative_tolerance": {
          "format": "double",
          "type": "number"
        },
        "source": {
          "type": "string"
        }
      },
      "required": [
        "absolute_tolerance",
        "evidence_kind",
        "expected",
        "formula",
        "id",
        "inputs",
        "relative_tolerance",
        "source"
      ],
      "type": "object"
    },
    "VerificationRow": {
      "additionalProperties": false,
      "properties": {
        "actual": {
          "format": "double",
          "type": [
            "number",
            "null"
          ]
        },
        "error": {
          "anyOf": [
            {
              "$ref": "#/definitions/Diagnostic"
            },
            {
              "type": "null"
            }
          ]
        },
        "fixture": {
          "$ref": "#/definitions/Fixture"
        },
        "passed": {
          "type": "boolean"
        }
      },
      "required": [
        "fixture",
        "passed"
      ],
      "type": "object"
    }
  },
  "properties": {
    "all_passed": {
      "type": "boolean"
    },
    "experimental_validation": {
      "type": "boolean"
    },
    "gate_g0": {
      "type": "string"
    },
    "gate_g1": {
      "type": "string"
    },
    "rows": {
      "items": {
        "$ref": "#/definitions/VerificationRow"
      },
      "type": "array"
    },
    "schema": {
      "type": "string"
    }
  },
  "required": [
    "all_passed",
    "experimental_validation",
    "gate_g0",
    "gate_g1",
    "rows",
    "schema"
  ],
  "title": "Verification",
  "type": "object"
}
